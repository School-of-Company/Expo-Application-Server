# Local development only. Copy to .env before starting Compose.
POSTGRES_HOST=localhost
POSTGRES_DB=expo_application
POSTGRES_USER=expo
POSTGRES_PASSWORD=expo_local
POSTGRES_PORT=25432
REDIS_HOST=localhost
REDIS_PORT=26379
SERVER_PORT=8080
APPLICATION_INTERNAL_TOKEN=replace-with-a-local-shared-token
APPLICATION_ATTENDANCE_ENABLED=false
APPLICATION_ATTENDANCE_URL=http://localhost:8084
# Must match Attendance INTERNAL_TOKEN before enabling delivery.
APPLICATION_ATTENDANCE_INTERNAL_TOKEN=
APPLICATION_REGISTRATION_ENABLED=false
APPLICATION_REGISTRATION_EXPO_URL=http://localhost:8081
APPLICATION_REGISTRATION_FORM_URL=http://localhost:8082
APPLICATION_REGISTRATION_USER_URL=http://localhost:8083
# Set these when the target services use different X-Internal-Token values.
# APPLICATION_REGISTRATION_EXPO_INTERNAL_TOKEN=
# APPLICATION_REGISTRATION_FORM_INTERNAL_TOKEN=
# APPLICATION_REGISTRATION_USER_INTERNAL_TOKEN=

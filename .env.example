# Local development only. Copy to .env before starting Compose.
POSTGRES_HOST=localhost
POSTGRES_DB=expo_application
POSTGRES_USER=expo
POSTGRES_PASSWORD=expo_local
POSTGRES_PORT=25432
REDIS_HOST=localhost
REDIS_PORT=26379
SERVER_PORT=8080
# Verifies X-Internal-Token on this service's /internal/** only; never sent to other services.
APPLICATION_INTERNAL_TOKEN=replace-with-a-local-application-token
APPLICATION_ADMIN_GROUP_MESSAGE_EXPO_URL=http://localhost:8081
APPLICATION_ADMIN_GROUP_MESSAGE_USER_URL=http://localhost:8083
APPLICATION_ADMIN_GROUP_MESSAGE_NOTIFICATION_URL=http://localhost:8085
# Required for each admin group messaging target whose URL is set. Must match
# Expo EXPO_INTERNAL_TOKEN, User INTERNAL_TOKEN and Notification ADMIN_GROUP_MESSAGING_INTERNAL_TOKEN.
APPLICATION_ADMIN_GROUP_MESSAGE_EXPO_INTERNAL_TOKEN=replace-with-local-expo-token
APPLICATION_ADMIN_GROUP_MESSAGE_USER_INTERNAL_TOKEN=replace-with-local-user-token
APPLICATION_ADMIN_GROUP_MESSAGE_NOTIFICATION_INTERNAL_TOKEN=replace-with-local-notification-token
APPLICATION_REGISTRATION_ENABLED=false
# Accepts new preregistration waiting parties only. Existing waiting parties keep promoting when false.
APPLICATION_PREREGISTER_WAITLIST_INTAKE_ENABLED=false
APPLICATION_PROGRAM_SESSIONS_ENABLED=false
APPLICATION_PROMOTIONS_ENABLED=false
APPLICATION_PROMOTIONS_BOOTSTRAP_SERVERS=localhost:9092
APPLICATION_PROMOTIONS_PUBLISH_FROM=
APPLICATION_REGISTRATION_EXPO_URL=http://localhost:8081
APPLICATION_REGISTRATION_FORM_URL=http://localhost:8082
APPLICATION_REGISTRATION_USER_URL=http://localhost:8083
APPLICATION_ATTENDANCE_ENABLED=false
APPLICATION_ATTENDANCE_URL=http://localhost:8084
# Must match Attendance INTERNAL_TOKEN before enabling standard preregistration.
APPLICATION_ATTENDANCE_INTERNAL_TOKEN=
# Optional development API docs; both default to false when omitted.
SWAGGER_ENABLED=false
# Only include internal API contracts when explicitly needed; never put tokens in examples.
SWAGGER_INCLUDE_INTERNAL=false
# Required when APPLICATION_REGISTRATION_ENABLED=true. Must match Expo EXPO_INTERNAL_TOKEN,
# Form INTERNAL_TOKEN and User INTERNAL_TOKEN. Admin operations and cancellation also use them.
APPLICATION_REGISTRATION_EXPO_INTERNAL_TOKEN=
APPLICATION_REGISTRATION_FORM_INTERNAL_TOKEN=
APPLICATION_REGISTRATION_USER_INTERNAL_TOKEN=
